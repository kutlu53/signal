      { "time": "09:00", "lessons": ["Maths", "English", "History", "Maths", "Music"] },
      { "time": "10:00", "lessons": ["Science", "PE", "English", "Science", "English"] },
      { "time": "11:00", "lessons": ["History", "Art", "Maths", "PE", "Maths"] },
      { "time": "13:30", "lessons": ["Music", "Science", "Art", "History", "PE"] }
    ], "extra": { "time": "??:??", "ms": 550, "cells": ["H", "E", "L", "L", "O"] } },
    { "type": "bg", "preset": "classroom_night", "signal": 0.95, "static": 0.9 },
    { "type": "say", "who": "echo", "text": "Lesson seven. Don't be late, {name}.", "tr": "Yedinci ders. Geç kalma, {name}." },
