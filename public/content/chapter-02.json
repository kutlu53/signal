  "vocab_key": ["wake up", "make the bed", "have breakfast", "walk to school", "check messages", "attend classes", "take notes", "have a break", "every day", "always", "never", "sometimes", "timetable", "registration"],
  "social": ["Bright and early!", "Hit the books!", "Work hard, play later!"],
