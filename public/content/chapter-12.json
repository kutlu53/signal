        { "text": "Yes, they did. An igloo.", "tr": "", "ok": false, "reply": { "who": "mei", "text": "Read again. A treehouse.", "tr": "Tekrar oku. Ağaç ev.", "expr": "think" } },
        { "text": "In a houseboat.", "tr": "", "ok": false, "reply": { "who": "leo", "text": "Mountains. A treehouse.", "tr": "Dağlar. Ağaç ev.", "expr": "think" } }
      ] } },
    { "type": "say", "who": "yasemin", "text": "\"Future friend.\" She wrote to us.", "tr": "\"Gelecekteki arkadaş.\" Bize yazmış.", "expr": "surprised" },

